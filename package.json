{
  "name": "casinobot",
  "version": "1.0.0",
  "description": "A self-hostable, multi-server Discord casino bot with Daily Dilemma prompts.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:prepare": "node scripts/prepare-database.mjs",
    "db:migrate": "npm run db:prepare && prisma migrate deploy",
    "commands:register": "tsx scripts/register-commands.ts",
    "commands:register:prod": "node dist/scripts/register-commands.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "discord.js": "^14.24.0",
    "dotenv": "^17.2.0",
    "luxon": "^3.7.0",
    "pino": "^9.14.0",
    "prisma": "7.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.0",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
