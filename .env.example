NODE_ENV=production
DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_CLIENT_ID=replace-with-your-application-id
# Optional: registers commands instantly in one development server.
DISCORD_GUILD_ID=
# Relative SQLite paths are resolved from the prisma/ directory.
DATABASE_URL=file:../data/casinobot.db
BOT_DISPLAY_NAME=CasinoBot
DEFAULT_TIMEZONE=America/Toronto
# Optional. Without a key, prompts and links still post; in-Discord voting is disabled.
DAILY_DILEMMA_API_KEY=
LOG_LEVEL=info
